<Window x:Class="OpenCodeJesk.OpenCodeUpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenCode update available"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowActivated="False" Topmost="False"
        Background="#1e1e1e">
    <Window.Resources>
        <ResourceDictionary Source="/OpenCodeJesk;component/Ui/UiButtonStyles.xaml" />
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="titleText" Grid.Row="0" Text="OpenCode update available"
                   FontSize="18" FontWeight="SemiBold" Foreground="#f1f1f1" TextWrapping="Wrap" />
        <TextBlock x:Name="subtitleText" Grid.Row="1" Margin="0,6,0,0"
                   FontSize="12" Foreground="#9a9a9a" TextWrapping="Wrap" />

        <TextBlock x:Name="instructionsText" Grid.Row="2" Margin="0,14,0,0"
                   FontSize="11" Foreground="#9a9a9a" TextWrapping="Wrap" />

        <TextBlock Grid.Row="3" Margin="0,10,0,0"
                   FontSize="11" Foreground="#9a9a9a" TextWrapping="Wrap"
                   Text="Don't want to be notified about OpenCode updates? This check can be disabled in settings." />

        <StackPanel Grid.Row="4">
            <TextBlock x:Name="statusText" Margin="0,10,0,0" FontSize="11"
                       Foreground="#9a9a9a" TextWrapping="Wrap" Visibility="Collapsed" />
            <StackPanel x:Name="buttonsPanel" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="notNowButton" Content="Not now" Padding="14,7" Margin="0,0,8,0"
                        Style="{StaticResource OutlineButton}" Click="OnNotNowClick" />
                <Button x:Name="updateButton" Content="Update now" Padding="18,7"
                        FontWeight="SemiBold" Style="{StaticResource AccentButton}" Click="OnUpdateClick" />
                <Button x:Name="closeButton" Content="Close" Padding="18,7"
                        FontWeight="SemiBold" Style="{StaticResource AccentButton}"
                        Visibility="Collapsed" Click="OnCloseClick" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
