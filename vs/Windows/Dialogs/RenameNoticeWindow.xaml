<Window x:Class="OpenCodeStudio.RenameNoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenCode Studio → OpenCode Jesk"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        ShowActivated="False" Background="#1e1e1e"
        WindowStyle="SingleBorderWindow">
    <Window.Resources>
        <ResourceDictionary Source="/OpenCodeStudio;component/Ui/UiButtonStyles.xaml" />
    </Window.Resources>
    <Border Background="#1e1e1e" Padding="0">
        <StackPanel Margin="24">
            <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="#f1f1f1"
                       TextWrapping="Wrap">
                <Run Text="OpenCode Studio is now " />
                <Run Text="OpenCode Jesk" Foreground="#5EACFC" />
            </TextBlock>

            <TextBlock x:Name="introText" Margin="0,14,0,0" FontSize="12"
                       Foreground="#cfcfcf" TextWrapping="Wrap"
                       Text="We renamed the extension to OpenCode Jesk. All functionality is identical - settings, providers, credentials and chat history are kept, nothing needs to be reconfigured." />

            <TextBlock Margin="0,12,0,0" FontSize="12" Foreground="#9a9a9a" TextWrapping="Wrap"
                       Text="Why: to give the extension an unambiguous name, because an unrelated Visual Studio Code extension already uses the same name." />

            <Border Margin="0,16,0,0" CornerRadius="6" Background="#252526"
                    BorderBrush="#3a3a3a" BorderThickness="1" Padding="14">
                <StackPanel>
                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#f1f1f1"
                               Text="How to switch" />
                    <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="#cfcfcf" TextWrapping="Wrap"
                               Text="1. Install OpenCode Jesk from the Visual Studio Marketplace (link below)." />
                    <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="#cfcfcf" TextWrapping="Wrap"
                               Text="2. Remove OpenCode Studio in Extensions → Manage Extensions." />
                    <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="#cfcfcf" TextWrapping="Wrap"
                               Text="Both use the same OpenCode data, so your chats appear immediately." />
                    <TextBlock Margin="0,10,0,0" FontSize="12" Foreground="#9a9a9a" TextWrapping="Wrap"
                               Text="Download: https://marketplace.visualstudio.com/items?itemName=jevkray.OpenCodeJesk" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="deadlineText" Margin="0,14,0,0" FontSize="12" FontWeight="SemiBold"
                       Foreground="#c9a24a" TextWrapping="Wrap"
                       Text="Support for OpenCode Studio ends on 20.10.2026. After that date only OpenCode Jesk is available." />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <CheckBox x:Name="dontShowCheck" Content="Do not show again" Foreground="#9a9a9a"
                          VerticalAlignment="Center" Margin="0,0,16,0" />
                <Button x:Name="laterButton" Content="Later" Padding="16,7" Margin="0,0,8,0"
                        Style="{StaticResource OutlineButton}" Click="OnLaterClick" />
                <Button x:Name="getButton" Content="Get OpenCode Jesk" Padding="18,7"
                        FontWeight="SemiBold" Style="{StaticResource AccentButton}" Click="OnGetClick" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
