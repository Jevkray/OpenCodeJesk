<Window x:Class="OpenCodeStudio.RatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenCode Jesk"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" Background="#1e1e1e" ShowInTaskbar="False">
    <Window.Resources>
        <ResourceDictionary Source="/OpenCodeStudio;component/Ui/UiButtonStyles.xaml" />
    </Window.Resources>
    <Border Background="#1e1e1e" BorderBrush="#3a3a3a" BorderThickness="1" Padding="24">
        <StackPanel>
            <TextBlock x:Name="titleText" FontSize="18" FontWeight="SemiBold"
                       Foreground="#f1f1f1" TextWrapping="Wrap"
                       Text="Enjoying OpenCode Jesk?" />
            <TextBlock x:Name="bodyText" Margin="0,12,0,0" FontSize="12"
                       Foreground="#cfcfcf" TextWrapping="Wrap"
                       Text="If the extension helps you, please leave a short review on the Marketplace. It takes a minute." />
            <CheckBox x:Name="dontShowCheck" Margin="0,16,0,0" Foreground="#9a9a9a"
                      Content="Don't show this again" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="alreadyButton" Content="I already did" Padding="16,7"
                        Margin="0,0,8,0" Style="{StaticResource OutlineButton}" Click="OnAlreadyClick" />
                <Button x:Name="reviewButton" Content="Leave a review" Padding="18,7"
                        FontWeight="SemiBold" Style="{StaticResource AccentButton}" Click="OnReviewClick" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
