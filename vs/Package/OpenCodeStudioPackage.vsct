<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable"
              xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />

  <Commands package="guidOpenCodeStudioPackage">

    <Bitmaps>
      <Bitmap guid="guidImages" href="..\Resources\CommandIcons.png" usedList="bmpCommand" />
    </Bitmaps>

    <Groups>
      <Group guid="guidOpenCodeCmdSet" id="grpOpenCodeWindow" priority="0x0000">
        <Parent guid="guidSHLMainMenu" id="IDG_VS_WNDO_OTRWNDWS1" />
      </Group>
    </Groups>

    <Buttons>
      <Button guid="guidOpenCodeCmdSet" id="cmdidShowOpenCodeWindow"
              priority="0x0100" type="Button">
        <Parent guid="guidOpenCodeCmdSet" id="grpOpenCodeWindow" />
        <Icon guid="guidImages" id="bmpCommand" />
        <Strings>
          <ButtonText>OpenCode Studio</ButtonText>
          <CommandName>OpenCode Studio</CommandName>
        </Strings>
      </Button>
      <Button guid="guidOpenCodeCmdSet" id="cmdidShowImport"
              priority="0x0300" type="Button">
        <Parent guid="guidOpenCodeCmdSet" id="grpOpenCodeWindow" />
        <Icon guid="guidImages" id="bmpCommand" />
        <Strings>
          <ButtonText>OpenCode Studio Settings</ButtonText>
          <CommandName>OpenCode Studio Settings</CommandName>
        </Strings>
      </Button>
    </Buttons>

  </Commands>

  <CommandPlacements>
    <CommandPlacement guid="guidOpenCodeCmdSet" id="cmdidShowOpenCodeWindow" priority="0x0100">
      <Parent guid="guidSHLMainMenu" id="IDG_VS_WNDO_OTRWNDWS1" />
    </CommandPlacement>
    <CommandPlacement guid="guidOpenCodeCmdSet" id="cmdidShowOpenCodeWindow" priority="0x0200">
      <Parent guid="guidSHLMainMenu" id="IDG_VS_TOOLS_OTHER2" />
    </CommandPlacement>
    <CommandPlacement guid="guidOpenCodeCmdSet" id="cmdidShowImport" priority="0x0400">
      <Parent guid="guidSHLMainMenu" id="IDG_VS_TOOLS_OTHER2" />
    </CommandPlacement>
  </CommandPlacements>

  <Symbols>

    <GuidSymbol name="guidImages" value="{A2B4C6D8-E0F1-2345-6789-ABCDEF012345}">
      <IDSymbol name="bmpCommand" value="1" />
    </GuidSymbol>

    <GuidSymbol name="guidOpenCodeStudioPackage" value="{7E4A9C31-2B6D-4F58-9A10-3C8E7B5D1F20}" />

    <GuidSymbol name="guidOpenCodeCmdSet" value="{D91F3A72-6C40-4E8B-B25D-8A47F0C63E15}">
      <IDSymbol name="grpOpenCodeWindow" value="0x1000" />
      <IDSymbol name="cmdidShowOpenCodeWindow" value="0x0100" />
      <IDSymbol name="cmdidShowImport" value="0x0102" />
    </GuidSymbol>

  </Symbols>

</CommandTable>
