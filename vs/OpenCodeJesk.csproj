<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>OpenCodeJesk</RootNamespace>
    <AssemblyName>OpenCodeJesk</AssemblyName>
    <LangVersion>latest</LangVersion>

    <!-- VSIX settings -->
    <VSSDKBuildToolsAutoSetup>true</VSSDKBuildToolsAutoSetup>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <UseCodebase>true</UseCodebase>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXDeployment>true</IncludeDebugSymbolsInVSIXDeployment>
    <IncludeDebugSymbolsInLocalVSIXDeployment>true</IncludeDebugSymbolsInLocalVSIXDeployment>

    <!-- Debug settings -->
    <StartAction>Program</StartAction>
    <StartProgram>$(DevEnvDir)devenv.exe</StartProgram>
    <StartArguments>/rootsuffix Exp</StartArguments>
    <VsixDeployOnDebug>true</VsixDeployOnDebug>

    <!-- Assembly info -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <!-- WPF and WinForms for WebView2 UI -->
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <!-- Единый бренд OpenCode Jesk: VSCT-файл задан безусловно. -->
  <PropertyGroup>
    <VsctFile>Package\OpenCodeJeskPackage.vsct</VsctFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectCapability Include="CreateVsixContainer" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.5.40034" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <VSCTCompile Include="$(VsctFile)">
      <ResourceName>Menus.ctmenu</ResourceName>
    </VSCTCompile>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\Icon.png">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\Icon.light.png">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\PreviewImage.png">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\IconJesk.png">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\PreviewImageJesk.png">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\CommandIcons.png">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Логотип как WPF-ресурс: нужен для pack-URI /OpenCodeJesk;component/Resources/IconJesk.png в XAML
       (окно расширения исполняется внутри devenv.exe, файл из Content там не виден). -->
  <ItemGroup>
    <Resource Include="Resources\IconJesk.png" />
    <Resource Include="Resources\qr\ton.png" />
    <Resource Include="Resources\qr\btc.png" />
    <Resource Include="Resources\qr\eth.png" />
    <Resource Include="Resources\quickstart\hero.png" />
    <Resource Include="Resources\quickstart\panel.png" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\CHANGELOG.md" LogicalName="Changelog.md" />
    <EmbeddedResource Include="Resources\ErrorPage.html" />
    <EmbeddedResource Include="Resources\LoadingPage.html" />
    <EmbeddedResource Include="Resources\UsageInjector.js" />
    <EmbeddedResource Include="Resources\Terminal.html" />
    <EmbeddedResource Include="Resources\xterm.js" />
    <EmbeddedResource Include="Resources\xterm.css" />
    <EmbeddedResource Include="Resources\addon-fit.js" />
    <Content Include="Resources\xterm-LICENSE.txt">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="Resources\addon-fit-LICENSE.txt">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Design" />
    <Reference Include="System.Security" />
    <Reference Include="WindowsFormsIntegration" />
  </ItemGroup>

</Project>
